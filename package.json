{
  "name": "opencode-hud",
  "version": "0.2.0",
  "main": "./dist/index.js",
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@opencode/plugin": "2.0.15",
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10",
    "@types/node": "^26.1.2",
    "babel-preset-solid": "^1.9.12",
    "solid-js": "1.9.15",
    "typescript": "7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "description": "OpenCode HUD minimal: model quota and live prompt-cache stats above the prompt.",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/prepare-tui-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "@opencode/plugin": "^2.0.0",
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": "^1.9.0"
  }
}
