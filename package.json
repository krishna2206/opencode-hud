{
  "name": "opencode-hud",
  "version": "0.2.0",
  "packageManager": "pnpm@11.0.0",
  "description": "OpenCode HUD minimal: compact quota status line + git branch in the TUI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "oc-plugin": [
    "server",
    "tui"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/prepare-tui-dist.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@opencode-ai/plugin": "1.18.11",
    "@types/node": "^22.0.0",
    "babel-preset-solid": "^1.9.12",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/solid": "0.4.5",
    "solid-js": "^1.9.12"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.4.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}